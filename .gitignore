# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
venv/
.env/
.env

# Environment variables
*.env
!.env.example

# Streamlit secrets (config.toml is committed)
.streamlit/secrets.toml

# Tooling caches
.pytest_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# VS Code
.vscode/

# PyCharm
.idea/

# Build artifacts
dist/
build/
*.egg-info/

# Temporary files
*.tmp
*.swp

# Local testing artifacts
*.sqlite3

# Node modules (in case frontend experiments exist)
node_modules/

# PDFs (real CVs must never be committed); test fixtures are allowed
*.pdf
!tests/fixtures/*.pdf