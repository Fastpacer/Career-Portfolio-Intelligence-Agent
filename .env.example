# Copy to `.env` in the repo root (found from any working directory).
# On Streamlit Cloud, put the same keys in the app's Secrets instead.

# Required: Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional (defaults shown)
# MODEL_NAME=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=medium        # low | medium | high; `none` for non-reasoning models
# LLM_MAX_TOKENS=8192                # covers hidden reasoning + the report
# LLM_TEMPERATURE=0.2
# GITHUB_API_URL=https://api.github.com
# GITHUB_TIMEOUT_SECONDS=10
# CV_MAX_CHARS=3500
# LOG_LEVEL=INFO
# LOG_FILE=app.log
